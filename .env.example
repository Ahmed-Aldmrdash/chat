# ==========================================
# Supabase
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الـ service_role — سيرفر فقط، ممنوع استخدامه في أي كود بيشتغل في المتصفح
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# الأدمن
# ==========================================
# إيميل حساب الأدمن (يُستخدم داخليًا فقط، المستخدم النهائي بيدخل username)
# لازم يطابق الإيميل الموجود جوه دالة public.is_admin() في قاعدة البيانات
ADMIN_EMAIL=

# الدومين الوهمي اللي بيتحوّل ليه الـ username (اختياري، الافتراضي تحت)
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=internal.yourapp.com

# ==========================================
# Web Push (VAPID) — ولّدهم بـ: npm run generate-vapid
# ==========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# ==========================================
# TURN Server (اختياري)
# ==========================================
# الـ STUN المجاني بيكفي في أغلب الشبكات. لو المكالمات فشلت مع بعض الأجهزة
# (NAT معقّد) هتحتاج TURN server من Twilio أو Metered.ca:
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ==========================================
# Cron
# ==========================================
# مفتاح سري عشوائي للتحقق من طلبات الـ Cron
CRON_SECRET=
